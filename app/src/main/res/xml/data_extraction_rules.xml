<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión no se respalda en la nube ni se transfiere a otro celular:
     su clave de cifrado vive en el Keystore de este equipo y en otro no serviría. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
